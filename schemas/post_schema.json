{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["userId", "id", "title", "body"],
  "properties": {
    "userId": {
      "type": "integer",
      "description": "用户ID"
    },
    "id": {
      "type": "integer",
      "description": "文章ID"
    },
    "title": {
      "type": "string",
      "description": "文章标题",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "description": "文章内容",
      "minLength": 1
    }
  }
}
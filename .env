# API 环境配置
API_ENV=test

# 各环境 Base URL
TEST_BASE_URL=https://jsonplaceholder.typicode.com
DEV_BASE_URL=https://jsonplaceholder.typicode.com
PROD_BASE_URL=https://jsonplaceholder.typicode.com

# 请求配置
REQUEST_TIMEOUT=30
REQUEST_RETRY=3

# 日志配置
LOG_LEVEL=INFO

# 认证配置（可选）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123